{
  "extends": "@terminal/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "rootDir": "src/lib",
    // P1.7 UI: gatewaySocket.ts is the app's first browser-API-touching lib
    // module (WebSocket/Location) — every prior src/lib file was pure enough
    // to need only base.json's ES2022 lib. Mirrors the DOM libs already in
    // the main tsconfig.json; doesn't change what node:test actually runs
    // (still plain compiled JS), only what compiles.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/lib"]
}
