{
  "name": "terminal",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:up": "bash scripts/dev-env.sh up",
    "dev:migrate": "bash scripts/dev-env.sh migrate",
    "dev:seed": "bash scripts/dev-env.sh seed",
    "dev:reset": "bash scripts/dev-env.sh reset",
    "dev:down": "bash scripts/dev-env.sh down",
    "dev:web": "turbo run dev --filter=@terminal/web",
    "dev:gateway": "turbo run dev --filter=@terminal/api-gateway"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
