# «TERMINAL» — environment template.
# Copy to .env and fill in. NEVER commit real values (see CLAUDE.md §9).
# All secrets are server-side only — never exposed to the browser or LLM prompts.

# --- Local dev infrastructure (docker-compose; see scripts/dev-env.sh) ---
# Superuser creds for the throwaway local Postgres container only — never reuse
# these anywhere real. Staging/prod get their creds from the secret manager.
POSTGRES_DB=terminal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
# Shared password `scripts/dev-env.sh migrate` assigns to all six svc_* roles
# (db/dev/set-passwords.sql) so each service can connect locally. Local dev only.
LOCAL_DEV_DB_PASSWORD=dev_local_only

# --- Stores ---
# Each service connects with its OWN role per ADR-005 (single-writer-per-table);
# only that role has write grants on the tables it owns (docs/architecture.md,
# docs/schema.md). Local dev password = LOCAL_DEV_DB_PASSWORD above; real
# environments get per-role passwords from the secret manager.
DATABASE_URL=postgres://user:password@localhost:5432/terminal
DATABASE_URL_MARKET_DATA=postgres://svc_market_data:dev_local_only@localhost:5432/terminal
DATABASE_URL_API_GATEWAY=postgres://svc_api_gateway:dev_local_only@localhost:5432/terminal
DATABASE_URL_QUANT=postgres://svc_quant:dev_local_only@localhost:5432/terminal
DATABASE_URL_AI=postgres://svc_ai:dev_local_only@localhost:5432/terminal
DATABASE_URL_ALERT_ENGINE=postgres://svc_alert_engine:dev_local_only@localhost:5432/terminal
DATABASE_URL_TELEGRAM_BOT=postgres://svc_telegram_bot:dev_local_only@localhost:5432/terminal
REDIS_URL=redis://localhost:6379

# --- Auth (api-gateway, P1.1) ---
PORT=8080
# JWT_SECRET is reserved for a future token-based use case — P1.1 uses opaque,
# random session tokens (SHA-256'd in Postgres), not JWTs.
JWT_SECRET=change-me
# Signs the session cookie (defense in depth on top of the DB-verified token —
# trading-security skill). Must be >=16 chars; this placeholder already is.
SESSION_SECRET=change-me-min-16-chars

# Where the gateway sends the browser after a successful OAuth login (P1.2c)
# — the web app's own origin, never the gateway's. Redirect URIs below route
# through apps/web's /api/* proxy (next.config.mjs) rather than straight at
# the gateway, so the Secure session cookie sets on the right origin.
WEB_APP_ORIGIN=https://localhost:3000

# Google OAuth (optional — /auth/google routes respond "not configured" if unset)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://localhost:3000/api/auth/google/callback

# Discord OAuth (optional — /auth/discord routes respond "not configured" if unset)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://localhost:3000/api/auth/discord/callback

# --- Market data vendors ---
COINGLASS_API_KEY=            # open-api-v4.coinglass.com, header CG-API-KEY
FINNHUB_API_KEY=
TRADING_ECONOMICS_API_KEY=

# --- News ---
CRYPTOPANIC_API_KEY=
COINGECKO_API_KEY=
ARKHAM_API_KEY=

# --- Telegram (bot + MTProto news ingestion; TELEGRAM_BOT_TOKEN is also used by
# api-gateway's /auth/telegram to verify the Login Widget signature, P1.1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bot username only (not secret) — apps/web renders the Telegram Login Widget
# with this (P1.2c). The bot also needs its domain authorized via
# @BotFather's /setdomain before the widget will work on it (docs/auth.md).
TELEGRAM_BOT_USERNAME=

# --- AI (managed tier vendor key; user BYO keys live encrypted in the DB, not here) ---
ANTHROPIC_API_KEY=

# --- Web (public, non-secret) ---
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-only (never shipped to the browser): where apps/web's next.config.mjs
# proxies /api/* to, so the gateway is same-origin from the browser (P1.2a,
# see docs/landing-page.md — this is what makes the Secure session cookie and
# CORS-free requests both work in local dev without weakening either).
GATEWAY_ORIGIN=http://localhost:8080
